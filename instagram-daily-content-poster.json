    {
      "id": "3343a2ff-595b-4621-bf32-6428c2a4881b",
      "name": "Write Caption",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        976,
        0
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-6.1-terra"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "system",
              "content": "You are a social media copywriter for an AI influencer Instagram account that earns through Amazon affiliate links and an online course. Write engaging, authentic captions. Output ONLY the final caption text, no preamble or quotes."
            },
            {
              "type": "text",
              "role": "user",
              "content": "=Write an Instagram caption for this post.\nTopic: {{ $json.topic }}\nNiche: {{ $json.niche }}\n\nRequirements:\n1. Start with a scroll-stopping hook (first line).\n2. Short, valuable body (2-4 short lines) related to the topic.\n3. A call-to-action that says \"link in bio\" (do not paste any URL).\n4. End with exactly 15 relevant hashtags on a new line, separated by spaces.\nKeep the total under 2000 characters."
            }
          ]
        },
        "options": {
          "maxTokens": 1500
        }
      }
    },
    {
      "id": "be2700d1-3101-4eb5-99ae-d4fd8df04c16",
      "name": "Create Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1376,
        128
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v23.0/{{ $(\"Config\").item.json.ig_user_id }}/media",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: $(\"Next Topic\").item.json.image_url, caption: $json.output[0].content[0].text }) }}"
      }
    },
    {
      "id": "76cf0e5e-bb18-4e43-991f-493c2335e7d5",
      "name": "Publish to Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
