      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "status-empty",
              "leftValue": "={{ $json.status }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ab10f71e-31aa-43a3-aa04-21861dd3410a",
      "name": "Next Pin",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "maxItems": 1,
        "keep": "firstItems"
      }
    },
    {
      "id": "8a180ec5-a2a8-4f3e-8f5b-5a560a5b7ad6",
      "name": "Create Pinterest Pin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/pins",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ board_id: String($json.board_id), title: String($json.title).slice(0, 100), description: String($json.description).slice(0, 800), link: $json.product_link, media_source: { source_type: \"image_url\", url: $json.image_url } }) }}"
      }
    },
    {
      "id": "6ab18801-ad96-4aad-aee0-bd90ed524655",
      "name": "Mark Row Posted",
      "type": "n8n-nodes-base.googleSheets",
