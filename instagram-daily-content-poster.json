      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v23.0/{{ $(\"Config\").item.json.ig_user_id }}/media_publish",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creation_id: $json.id }) }}"
      }
    },
