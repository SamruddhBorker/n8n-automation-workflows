{
  "name": "Pinterest Auto Poster",
  "nodes": [
    {
      "id": "d9fcf17e-2960-4631-a325-b31c2e1501e9",
      "name": "Schedule 3x Daily (US)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,13,20 * * *"
            }
          ]
        }
      }
    },
    {
