    {
      "id": "105eeb55-ba7e-46fb-a1f6-c0d365281d64",
      "name": "Chat with Documents",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        720
      ],
      "parameters": {
        "public": false,
        "options": {}
      }
    },
    {
      "id": "e6ade1cf-f4f7-449b-8fa9-2bb9ff6d2759",
      "name": "RAG Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        288,
        720
      ],
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "You are a document assistant. You answer questions strictly using the documents the user has uploaded.\n\nRules:\n1. For every question, first call the search_documents tool to retrieve relevant passages.\n2. Answer ONLY with information found in the retrieved passages. Never use outside knowledge or guess.\n3. Cite your sources: end every answer with a \"Sources\" line listing the document_name (and page number if available in the metadata) of each passage you used.\n4. If the retrieved passages do not contain the answer, or nothing relevant is returned, reply exactly: \"I don't know. I couldn't find that in the uploaded documents.\" Do not add a Sources line in that case.\n5. Keep answers concise and clear."
        }
      }
    },
    {
      "id": "d44e3b01-00e4-4e7d-b030-caed8a04d9a2",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        224,
        944
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-6.1-terra"
        },
        "options": {}
      }
    },
    {
      "id": "8e72ba86-133d-44fa-b584-62399c21d6ed",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
